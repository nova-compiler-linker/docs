function gcd(a: int, b: int) -> int {
	if a < 0 {
		return gcd(b,a);
	}
	let r = a % b;
	
	if r == 0 {
		return b;
	}
	else {
		return gcd(b, r);
	}
}

function main() -> int {
	let a = 0;
	let b = 0;

	println("please input two positive integers:");
	input(a, b);

	println("the greatest common divisor of {} and {} is {}", a, b, gcd(a, b));

	return 0;
}