import math;

function main() -> int {
	let a = 0.0;
	let b = 0.0;
	let c = 0.0;

	print("please input a, b, c: ");
	input(a, b, c);

	let d = math::sqrt(b * b - 4 * a * c);
	match d {
		d > 0 => {
			let x1 = (-b + d) / (2 * a);
			let x2 = (-b - d) / (2 * a);
			println("the equation has two real roots: ");
			println("x1 = {}, x2 = {}", x1, x2);
		}

		d == 0 => {
			println("the equation has one real root: ");
			println("x = {}", -b / (2 * a));
		}

		d < 0 =>{
			println("the equation doesn't have any real roots.");
		}
	}

	return 0;
}