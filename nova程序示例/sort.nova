function select_sort(a: &array) -> void {
	let i = 0;
	let j = 0;
	let k = 0;

	let n = a.length();
	for i in range(0 : n - 1) {
		k = i;
		for j in range(i + 1, n) {
			if a[j] < a[k] {
				k = j;
			}
		}

		if k <> i {
			a[k], a[i] = a[i], a[k]
		}
	}
}

function print_arr(a: const &array) -> void {
	for i in range(0, a.length()) {
		print("{} ", a[i]);
	}
	println();
}

function main() -> int {
	let arr: array[int | 9] = [9, 3, 7, 5, 1, 8, 6, 4, 2];
	print_arr(arr);

	select_sort(arr);
	print_arr(arr);

	return 0;
}